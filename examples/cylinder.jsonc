{
  "kind": "analysis-suite",
  "name": "Cylinder",
  "description": "Cylinder dNamiX dataset with all current OpenModalPy methods using spatial stride-2 loading.",
  "case": {
    "name": "cylinder",
    "case_type": "experimental",
    "description": "Cylinder NPZ example.",
    "data": {
      "kind": "dnami",
      "path": "../data/cylinder",
      "schema": {
        "layout": "consolidated_npz",
        "files": {
          "pattern": "*.npz"
        },
        "reduction": {
          "x_stride": 2,
          "y_stride": 2
        }
      }
    },
    "spatial_weight_type": "uniform",
    "n_modes_save": 10,
    "rank": 10,
    "nfft": 128,
    "overlap": 0.5,
    "embedding_dim": 10,
    "generate_plots": true,
    "results_root": "../results/cylinder",
    "figures_root": "../figures/cylinder"
  },
  "runs": [
    { "id": "pod", "method": "pod" },
    { "id": "mpod", "method": "mpod", "params": { "band_edges": [0.0, 0.15, 0.35, 1.0], "band_scale": "normalized_nyquist" } },
    { "id": "dmd_ls", "method": "dmd", "params": { "method": "ls", "delays": 1 } },
    { "id": "dmd_tls", "method": "dmd", "params": { "method": "tls", "delays": 1 } },
    { "id": "hodmd", "method": "hodmd", "params": { "delays": 2, "n_modes_save": 4, "rank": 4 } },
    { "id": "tls_hodmd", "method": "tls-hodmd", "params": { "delays": 2, "n_modes_save": 4, "rank": 4 } },
    { "id": "spod", "method": "spod" },
    { "id": "psd_pod", "method": "psd-pod" },
    { "id": "bsmd", "method": "bsmd" },
    { "id": "stpod", "method": "stpod", "params": { "max_snapshots": 400 } }
  ]
}
