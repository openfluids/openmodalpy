{
  "kind": "analysis-suite",
  "name": "Jet LES Small",
  "description": "Reduced jet LES dataset with all methods, including PSD-POD and DMD variants.",
  "case": {
    "name": "jet_small",
    "case_type": "experimental",
    "description": "Small jet LES example.",
    "data": {
      "kind": "file",
      "path": "../data/jet/jetLES_small.mat"
    },
    "spatial_weight_type": "polar",
    "n_modes_save": 10,
    "rank": 10,
    "nfft": 128,
    "overlap": 0.5,
    "embedding_dim": 10,
    "generate_plots": true,
    "results_root": "../results/jet_small",
    "figures_root": "../figures/jet_small"
  },
  "runs": [
    { "id": "pod", "method": "pod" },
    { "id": "mpod", "method": "mpod", "params": { "band_edges": [0.0, 0.15, 0.35, 1.0], "band_scale": "normalized_nyquist" } },
    { "id": "dmd_ls", "method": "dmd", "params": { "method": "ls", "embedding_dim": 1 } },
    { "id": "dmd_tls", "method": "dmd", "params": { "method": "tls", "embedding_dim": 1 } },
    { "id": "hodmd", "method": "hodmd", "params": { "embedding_dim": 4 } },
    { "id": "tls_hodmd", "method": "tls-hodmd", "params": { "embedding_dim": 4 } },
    { "id": "spod", "method": "spod" },
    { "id": "psd_pod", "method": "psd-pod" },
    { "id": "bsmd", "method": "bsmd" },
    { "id": "stpod", "method": "stpod" }
  ]
}
