{
  "kind": "analysis-suite",
  "name": "Cylinder Wake",
  "description": "Synthetic von Karman cylinder wake with the full OpenModalPy method matrix.",
  "case": {
    "name": "cylinder_wake",
    "case_type": "analytical",
    "description": "Synthetic cylinder wake example.",
    "data": {
      "kind": "generator",
      "name": "cylinder_wake",
      "params": {
        "Nx": 100,
        "Ny": 50,
        "Nt": 500,
        "seed": 42
      }
    },
    "spatial_weight_type": "uniform",
    "n_modes_save": 10,
    "rank": 10,
    "nfft": 128,
    "overlap": 0.5,
    "embedding_dim": 20,
    "generate_plots": true,
    "results_root": "../results/cylinder_wake",
    "figures_root": "../figures/cylinder_wake"
  },
  "runs": [
    { "id": "pod", "method": "pod" },
    { "id": "mpod", "method": "mpod", "params": { "band_edges": [0.0, 0.15, 0.35, 1.0], "band_scale": "normalized_nyquist" } },
    { "id": "dmd_ls", "method": "dmd", "params": { "method": "ls", "embedding_dim": 1 } },
    { "id": "dmd_tls", "method": "dmd", "params": { "method": "tls", "embedding_dim": 1 } },
    { "id": "hodmd", "method": "hodmd", "params": { "embedding_dim": 4 } },
    { "id": "tls_hodmd", "method": "tls-hodmd", "params": { "embedding_dim": 4 } },
    { "id": "spod", "method": "spod" },
    { "id": "psd_pod", "method": "psd-pod" },
    { "id": "bsmd", "method": "bsmd" },
    { "id": "stpod", "method": "stpod" }
  ]
}
